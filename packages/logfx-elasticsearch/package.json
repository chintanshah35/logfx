{
  "name": "logfx-elasticsearch",
  "version": "1.0.0",
  "description": "Elasticsearch integration for logfx",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["logfx", "elasticsearch", "elk", "logging", "search"],
  "license": "MIT",
  "peerDependencies": {
    "logfx": "^0.5.0",
    "@elastic/elasticsearch": "^8.0.0"
  },
  "devDependencies": {
    "@elastic/elasticsearch": "^8.0.0",
    "logfx": "workspace:*",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2"
  }
}
