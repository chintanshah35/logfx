{
  "name": "logfx-cloudwatch",
  "version": "1.0.0",
  "description": "AWS CloudWatch Logs integration for logfx",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "logfx",
    "cloudwatch",
    "aws",
    "logging"
  ],
  "license": "MIT",
  "peerDependencies": {
    "logfx": "^1.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1004.0"
  },
  "devDependencies": {
    "logfx": "file:../logfx",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  }
}
