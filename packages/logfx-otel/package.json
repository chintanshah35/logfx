{
  "name": "logfx-otel",
  "version": "1.0.0",
  "description": "OpenTelemetry integration for logfx",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "logfx",
    "opentelemetry",
    "otel",
    "logging",
    "observability",
    "tracing",
    "distributed-tracing"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "logfx": "^1.0.0",
    "@opentelemetry/api": "^1.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "logfx": "file:../logfx",
    "@types/node": "^25.3.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/logfx.git",
    "directory": "packages/logfx-otel"
  }
}
