{
  "name": "logfx-monorepo",
  "private": true,
  "description": "logfx monorepo - Production-ready logging for JavaScript",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "rollup": "4.68.3",
    "brace-expansion": "5.0.12",
    "picomatch": "4.0.4"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:run": "npm run test:run --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@sentry/node": "^11.14.0",
    "@types/node": "^20.19.27",
    "tsup": "^8.5.1",
    "typescript": "^5.3.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  }
}
